@model BestFit.Web.Models.HomeIndexResponseDTO

@{
    ViewData["Title"] = "Home";
}


<!-- Header -->
<header class="header header-main header-sticky">
    <div class="pb-2 py-lg-3">
        <div class="container text-light">
            <div class="row align-items-center">

                <div class="col-lg-4 text-lg-right pt-2 pt-lg-0">
                    <ol class="breadcrumb breadcrumb-light justify-content-lg-end">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>

                    </ol>
                </div>
            </div>
        </div>
    </div>
</header>

<!--Featured Content Banner-->
<section class="section bg-white">
    <div class="container">
        <div class="box box-image box-parallax br-md" style="background-image:url(@Model.featuredContent.Find(x => x.Name == "top-page").ImageUrl)">
            <div class="box-content px-5 text-center text-white">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <h1 class="display-4">@Model.featuredContent.Find(x => x.Name == "top-page").Heading</h1>
                        <p class="lead mb-5">
                            @Model.featuredContent.Find(x => x.Name == "top-page").SubHeading
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Top columns -->

<section class="bg-white p-0">
    <div class="container">
        <div class="row">
            @foreach(var category in Model.categories)
            {
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <div class="wow fadeInUp" data-wow-delay=".2s">
                        <div class="box box-image box-hover-fall br-sm" style="background-image:url(@category.ImageUrl)">
                            <div class="box-spacer-xl"></div>
                            <div class="box-content">
                                <h2 class="display-4 font-family-body text-white">
                                    <strong>@category.Name</strong>
                                </h2>
                                <p><span><a asp-controller="Shop" asp-action="NewArrivals" asp-route-id="@category.Id" class="text-muted">New arrivals</a></span></p>
                                <p><span><a asp-controller="Shop" asp-action="DiscountSales" asp-route-id="@category.Id" class="text-muted">Discount sales</a></span></p>
                                <p><span><a asp-controller="Shop" asp-action="Index" asp-route-id="@category.Id" class="text-muted">More</a></span></p>
                            </div>
                        </div>
                    </div>
                </div>
            }
            
            
        </div>
    </div>
</section>

<!-- Sport collections -->

<section class="bg-white">
    <div class="container">

        <header class="wow fadeInUp" data-wow-delay=".2s">
            <h2 class="display-4">Explore <strong>sport</strong> collections</h2>
        </header>

        <div class="wow fadeInUp" data-wow-delay=".2s">
            <div class="row">
                @foreach(var category in Model.sportCollectionCategories)
                {
                    <div class="col mb-3 mb-lg-0">
                        <a asp-controller="Shop" asp-action="Index" asp-route-category="@category.Id" class="btn btn-rounded btn-block btn-outline-dark">@category.Name</a>
                    </div>
                }
                
                <div class="col mb-3 mb-lg-0">
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-rounded btn-block btn-dark text-nowrap">All categories</a>
                </div>
            </div>
        </div>

    </div>
</section>

<hr class="m-0">

<!-- Popular categories -->

<section class="bg-white">
    <div class="container">

        <header class="wow fadeInUp" data-wow-delay=".2s">
            <h2 class="display-4">Popular <strong>categories</strong></h2>
        </header>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="wow fadeInUp" data-wow-delay=".4s">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.popularCategories.Find(x=>x.Name=="Jackets").Id" class="box box-image box-hover-pull br-sm" style="background-image:url(@Model.popularCategories.Find(x=>x.Name=="Jackets").ImageUrl">
                        <div class="box-spacer-xl"></div>
                        <div class="box-content text-white text-center">
                            <header>
                                <div class="display-3"><strong>@Model.popularCategories.Find(x => x.Name == "Jackets").Name</strong> </div>
                            </header>
                            
                        </div>
                    </a>
                </div>
            </div>
            
            <div class="col-md-6 mb-4">
                <div class="wow fadeInUp" data-wow-delay=".6s">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.popularCategories.Find(x => x.Name == "Bags").Id" class="box box-image box-hover-pull br-sm" style="background-image:url(@Model.popularCategories.Find(x => x.Name == "Bags").ImageUrl)">
                        <div class="box-spacer-xl"></div>
                        <div class="box-content text-white text-center">
                            <header>
                                <span class="display-3"><strong>@Model.popularCategories.Find(x => x.Name == "Bags").Name</strong></span>
                            </header>
                            
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="wow fadeInUp" data-wow-delay=".7s">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.popularCategories.Find(x => x.Name == "Outdoor").Id" class="box box-image box-hover-pull br-sm" style="background-image:url(@Model.popularCategories.Find(x => x.Name == "Outdoor").ImageUrl)">
                        <div class="box-spacer-xl"></div>
                        <div class="box-content text-white text-center">
                            <header>
                                <span class="display-4"><strong>@Model.popularCategories.Find(x => x.Name == "Outdoor").Name</strong></span>
                            </header>
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="wow fadeInUp" data-wow-delay=".9s">
                    <a asp-action="Index" asp-controller="Shop" asp-route-categoryId="@Model.popularCategories.Find(x => x.Name == "Winterski").Id" class="box box-image box-hover-pull br-sm" style="background-image:url(@Model.popularCategories.Find(x => x.Name == "Winterski").ImageUrl)">
                        <div class="box-spacer-xl"></div>
                        <div class="box-content text-white text-center">
                            <header>
                                <span class="display-4"><strong>@Model.popularCategories.Find(x => x.Name == "Winterski").Name</strong></span>
                            </header>
                           
                        </div>
                    </a>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="wow fadeInUp" data-wow-delay=".9s">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.popularCategories.Find(x => x.Name == "Sport").Id" class="box box-image box-hover-pull br-sm" style="background-image:url(../assets/images/templates//clothing/ladie-3.jpg)">
                        <div class="box-spacer-xl"></div>
                        <div class="box-content text-white text-center">
                            <header>
                                <span class="display-4"><strong>@Model.popularCategories.Find(x => x.Name == "Sport").Name</strong></span>
                            </header>
                        </div>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<hr class="m-0">

<!-- Sale black friday -->

<section class="bg-white">
    <div class="container">

        <header class="wow fadeInUp" data-wow-delay=".2s">
            <h2 class="display-4">Sale <strong>black friday</strong> 70% off</h2>
        </header>

        <div class="row mx-n1">
            @foreach (var product in Model.blackFridaySales) 
            {
                <div class="col-6 col-xl-3 p-1">
                    <div class="wow fadeInUp" data-wow-delay=".0s">
                        <div class="card card-fill">
                            <div class="card-image">
                                <a asp-controller="Product" asp-action="Index" asp-route-productId="@product.Id">
                                    <img src="@product.ImageUrl" class="card-img-top img-hover" data-img="@product.ImageUrl" data-img-hover="@product.ImageUrl" alt="...">
                                </a>
                            </div>
                            <div class="card-body p-3 p-lg-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h2 class="card-title mb-1 h5">
                                            <a asp-controller="Product" asp-action="Index" asp-route-productId="@product.Id class="text-dark">
                                                Coretta
                                            </a>
                                        </h2>
                                        <small class="pre-label text-muted">
                                            <span>Ksh @product.Price</span>
                                        </small>
                                    </div>
                                    <div>
                                        <a asp-controller="Cart" asp-action="Add" asp-route-productId="@product.Id class="d-inline-block" data-toggle="tooltip" data-placement="top" title="Add to cart">
                                            <i class="icon icon-cart font-size-xl"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            

        </div>

        <div class="text-right pt-4">
            <a href="#" class="link link-main link-dark">View collection</a>
        </div>

    </div>

</section>

<!-- Banner winter is beautiful -->

<section class="bg-dark cover" style="background-image: url(@Model.featuredContent.Find(x => x.Name == "mid-page").ImageUrl);">
    <div class="container">
        <div class="row justify-content-start">
            <div class="col-md-6">
                <h2 class="display-4">@Model.featuredContent.Find(x => x.Name == "mid-page").Heading</h2>
                <p>@Model.featuredContent.Find(x => x.Name == "mid-page").SubHeading</p>
            </div>
        </div>
    </div>
</section>

<!-- Popular woman&#x27;s products -->

<section class="bg-white">
    <div class="container">

        <header class="wow fadeInUp" data-wow-delay=".2s">
            <h2 class="display-4">Popular <strong>woman's</strong> products</h2>
        </header>

        <div class="row mx-n1">
            @foreach(var womenproduct in Model.popularWomenProducts)
            {
                <div class="col-6 col-xl-3 p-1">
                    <div class="wow fadeInUp" data-wow-delay=".0s">
                        <div class="card card-fill">
                            <div class="card-body p-3 p-lg-4">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h2 class="card-title mb-1 h5">
                                            <a asp-controller="Product" asp-action="Index" asp-route-productId="@womenproduct.Id" class="text-dark">
                                                @womenproduct.Name
                                            </a>
                                        </h2>
                                        <small class="pre-label text-muted">
                                            <span>Ksh @womenproduct.Price</span>
                                        </small>
                                    </div>
                                    <div>
                                        <a asp-controller="Cart" asp-action="Add" asp-route-productId="@womenproduct.Id" class="d-inline-block" data-toggle="tooltip" data-placement="top" title="Add to cart">
                                            <i class="icon icon-cart font-size-xl"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="card-image pb-4">
                                <a asp-controller="Product" asp-action="Index" asp-route-productId="@womenproduct.Id">
                                    <img src="@womenproduct.ImageUrl" class="card-img-top img-hover" data-img="@womenproduct.ImageUrl" data-img-hover="@womenproduct.ImageUrl" alt="...">
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
            

            
        </div>

        <div class="text-right pt-4">
            <a asp-controller="Shop" asp-action="Index" class="link link-main link-dark">View collection</a>
        </div>
    </div>

</section>

<!-- Footer banner -->

<section class="p-0">
    <div class="position-relative">
        <div class="cover cover-overlay" style="background-image: url(@Model.featuredContent.Find(x=>x.Name=="bottom-page").ImageUrl);"></div>
        <div class="py-8 text-white">
            <div class="container">
                <div class="row justify-content-end">
                    <div class="col-md-6">
                        <h2 class="display-4">@Model.featuredContent.Find(x => x.Name == "bottom-page").Heading</h2>
                        <p>@Model.featuredContent.Find(x => x.Name == "bottom-page").SubHeading</p>
                        @* <a href="#" class="btn btn-rounded btn-outline-light">View collection</a> *@
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Clothing categories -->

<section class="bg-light">
    <div class="container">

        <div class="wow fadeInUp" data-wow-delay=".2s">
            <div class="row py-4">
                <div class="col-lg-3 mb-4 mb-lg">
                    <h2 class="mb-0">Clothing</h2>
                    <p><a asp-controller="Category" asp-action="Index"  class="link link-main link-dark">Explore all categories</a></p>
                </div>
                <div class="col-lg-9">
                    <div class="row">
                        @foreach(var clothingCategory in Model.clothingCategories)
                        {
                            <div class="col col-lg-3 mb-3">
                                <a asp-controller="Category" asp-action="Index" asp-route-productId="@clothingCategory.Id" class="btn btn-rounded btn-block btn-sm btn-outline-dark text-nowrap">@clothingCategory.Name</a>
                            </div>
                        }
                        
                       
                    </div>
                </div>
            </div>
        </div>


        <div class="wow fadeInUp" data-wow-delay=".6s">
            <hr>
            <div class="row py-4">
                <div class="col-lg-3 mb-4 mb-lg">
                    <h2 class="mb-0">Shoes</h2>
                    <p><a asp-controller="Category" asp-action="Index" class="link link-main link-dark">Explore all categories</a></p>
                </div>
                <div class="col-lg-9">
                    <div class="row">
                        @foreach (var clothingCategory in Model.clothingCategories)
                        {
                            <div class="col col-lg-3 mb-3">
                                <a asp-controller="Category" asp-action="Index" asp-route-productId="@clothingCategory.Id" class="btn btn-rounded btn-block btn-sm btn-outline-dark text-nowrap">@clothingCategory.Name</a>
                            </div>
                        }
                        
                    </div>
                </div>
            </div>
        </div>


        <div class="wow fadeInUp" data-wow-delay=".8s">
            <hr>
            <div class="row py-4">
                <div class="col-lg-3 mb-4 mb-lg">
                    <h2 class="mb-0">Equipment</h2>
                    <p><a asp-controller="Category" asp-action="Index" class="link link-main link-dark">Explore all categories</a></p>
                </div>
                <div class="col-lg-9">
                    <div class="row">
                        @foreach (var clothingCategory in Model.clothingCategories)
                        {
                            <div class="col col-lg-3 mb-3">
                                <a asp-controller="Category" asp-action="Index" asp-route-productId="@clothingCategory.Id" class="btn btn-rounded btn-block btn-sm btn-outline-dark text-nowrap">@clothingCategory.Name</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

