@model BestFit.Shared.DTOs.RequestDTOs.RegisterRequestDTO

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<!-- register -->

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card card-panel bg-white shadow-sm mb-2">

                <div class="card-header py-4 bg-white" role="button" id="headingOne" data-toggle="collapse" data-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    <h2 class="h4 mb-0">Register now</h2>
                </div>

                <div id="collapseOne" class="collapse show" aria-labelledby="headingOne" data-parent="#accordion1">
                    <div class="card-body p-0">
                        <hr class="m-0">
                        <div class="p-4 p-md-6">
                            <form asp-controller="Account"
                                  asp-action="Register"
                                  method="post">
                                <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] ?? "/")" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                                <div class="row">

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input asp-for="FirstName" class="form-control form-control-simple" type="text" value="" class="" placeholder="First name " />
                                            <span asp-validation-for=FirstName></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input asp-for="LastName" type="text" value="" class="form-control form-control-simple" placeholder="Last Name">
                                            <span asp-validation-for=LastName></span>
                                        </div>
                                    </div>



                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <input asp-for="Email" type="email" value="" class="form-control form-control-simple" placeholder="Email">
                                            <span asp-validation-for=Email></span>
                                        </div>
                                    </div>
                                    <br />
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input asp-for="Password" type="password" value="" class="form-control form-control-simple" placeholder="Password">
                                            <span asp-validation-for=Password></span>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <input asp-for="ConfirmPassword" type="password" value="" class="form-control form-control-simple" placeholder="Confirm Password">
                                            <span asp-validation-for=ConfirmPassword></span>
                                        </div>
                                    </div>



                                    

                                    <div class="col-md-12 text-right py-4">
                                        <button type="submit" class="btn btn-primary">Register</button>
                                    </div>

                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"/>
}