@{
}
<form asp-controller="Search"
      asp-action="Search"
      method="post">
    <input type="hidden" name="returnUrl" value="@(ViewData["ReturnUrl"] ?? "/")" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="form-group form-group-icon">
        <input asp-for="Keyword" type="text" class="form-control form-control-simple" aceholder="Search site" />
        <span asp-validation-for=Keyword></span>
        <button type="submit" class="btn btn-clean"><i class="icon icon-magnifier"></i></button>
    </div>

</form>