@{
    
}


<!-- Breadcrumbs -->

<header class="header header-main header-sticky bg-dark">
    <div class="pb-2 py-lg-3">
        <div class="container text-light">
            <div class="row align-items-center">
                @* <div class="col-lg-8">
                    <h2 class="mb-0 h4">My profile</h2>
                    <small class="pre-label d-none d-lg-block">User accout</small>
                </div> *@
@*                 <div class="col-lg-4 text-lg-right pt-2 pt-lg-0">
                    <ol class="breadcrumb breadcrumb-light justify-content-lg-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item"><a href="#">Library</a></li>
                        <li class="breadcrumb-item"><a href="#">Category</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Data</li>
                    </ol>
                </div>
 *@            </div>
        </div>
    </div>
</header>


@if (TempData["AvatarMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["AvatarMessage"]
    </div>
}
<!-- Profile dashboard -->

<section class="pt-0">
    <div class="container">
        <div class="row">

            @await Html.PartialAsync("ProfileSidebarLinks")
            
            <!-- Dashboard details -->

            <div class="col-lg-9 pt-lg-4">

                <h2 class="pre-label font-size-base">Avatar settings</h2>

                <div class="bg-white p-4 p-lg-5 br-sm shadow-sm mb-3 mb-lg-5">
                    <div>
                        
                        <div class="media d-block d-sm-flex align-items-center">
                           @* Select Which Profile you want to browse on *@
                            <form asp-controller="Profile" asp-action="SetAvatar" method="post">
                                <div class="form-group">
                                    <p>Current avatar:</p>
                                    <select asp-for="@Model.SelectedAvatarId" asp-items="@Model.Avatars"  class="form-control">
                                    </select>
                                    

                                </div>
                                <div class="form-group">
                                    <button type="submit" value="Save" class="btn btn-success btn-sm btn-rounded">Set avatar</button>
                                    <button value="Save" class="btn btn-warning btn-sm btn-rounded">Modify</button>
                                    <button value="Save" class="btn btn-danger btn-sm btn-rounded">Delete</button>
                                </div>
                                <hr />
                                <button type="submit" asp-action="SetAvatar" value="Save" class="btn btn-info btn-sm btn-rounded">New avatar</button>

                                
                            </form>
                        </div>
                    </div>
                </div>

                <h2 class="pre-label font-size-base">Profile settings</h2>

                <div class="bg-white p-4 p-lg-5 br-sm shadow-sm mb-3 mb-lg-5">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="pre-label pre-label-sm" for="account-fn">First Name</label>
                                <input class="form-control form-control-simple" type="text" id="account-fn" value="@Model.FirstName">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="pre-label pre-label-sm" for="account-ln">Last Name</label>
                                <input class="form-control form-control-simple" type="text" id="account-ln" value="@Model.LastName">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="pre-label pre-label-sm" for="account-ln">Address</label>
                                <input class="form-control form-control-simple" type="text" id="account-ln" value="@Model.Address">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="pre-label pre-label-sm" for="account-ln">Postal Code</label>
                                <input class="form-control form-control-simple" type="text" id="account-ln" value="@Model.PostalCode">
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label class="pre-label pre-label-sm" for="account-ln">Phone</label>
                                <input class="form-control form-control-simple" type="text" id="account-ln" value="@Model.CellPhone">
                            </div>
                            <button class="btn btn-rounded btn-outline-primary btn-sm px-3 mt-3 mt-sm-0" type="button">
                                <i class="fa fa-save mr-2"></i>Save changes
                            </button>
                        </div>
                        
                        
                        
                        
                     
                        
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
